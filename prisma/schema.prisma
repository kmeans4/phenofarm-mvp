generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  role                 UserRole              @default(GROWER)
  growerId             String?
  dispensaryId         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  passwordHash         String?
  emailVerifiedAt      DateTime?
  sessionVersion       Int                   @default(0)
  accountActionTokens  AccountActionToken[]
  conversationMessages ConversationMessage[]
  createdConversations Conversation[]        @relation("ConversationCreator")
  notifications        Notification[]
  orderStatusEvents    OrderStatusEvent[]
  dispensary           Dispensary?
  grower               Grower?

  @@map("users")
}

enum AccountActionPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

model AccountActionToken {
  id             String               @id @default(cuid())
  tokenHash      String               @unique
  userId         String
  purpose        AccountActionPurpose
  email          String
  sessionVersion Int
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("account_action_tokens")
}

model Grower {
  id                            String              @id @default(cuid())
  userId                        String              @unique
  businessName                  String
  licenseNumber                 String?
  phone                         String?
  address                       String?
  city                          String?
  state                         String?             @default("VT")
  zip                           String?
  website                       String?
  description                   String?
  logo                          String?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  isVerified                    Boolean             @default(false)
  stripeCustomerId              String?
  stripeSubscriptionId          String?
  stripeCheckoutSessionId       String?
  subscriptionPlan              String?             @default("free")
  subscriptionStatus            String?             @default("inactive")
  subscriptionCurrentPeriodEnd  DateTime?
  subscriptionCancelAtPeriodEnd Boolean             @default(false)
  subscriptionEventCreatedAt    Int                 @default(0)
  contactName                   String?
  licenseExpiry                 DateTime?
  commercialMinimumOrder        String?
  commercialFulfillmentMethods  String?
  commercialFulfillmentRegion   String?
  commercialPaymentTerms        String?
  commercialResponseWindow      String?
  commercialContactNote         String?
  commercialTermsUpdatedAt      DateTime?
  batches                       Batch[]
  conversations                 Conversation[]
  user                          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems                    OrderItem[]
  orders                        Order[]
  productTypeConfigs            ProductTypeConfig[]
  products                      Product[]
  strains                       Strain[]
  acceptedQuotes                AcceptedQuote[]
  managedCustomers              Dispensary[] @relation("ManagedCustomers")

  @@map("growers")
}

model Dispensary {
  id                 String                      @id @default(cuid())
  userId             String?                     @unique
  businessName       String
  licenseNumber      String?
  phone              String?
  address            String?
  city               String?
  state              String?                     @default("VT")
  zip                String?
  website            String?
  description        String?
  logo               String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  isVerified         Boolean                     @default(false)
  contactName        String?
  licenseExpiry      DateTime?
  licenseReviewNotes String?
  licenseState       String?                     @default("VT")
  licenseStatus      LicenseStatus               @default(pending_review)
  verifiedAt         DateTime?
  isOffPlatform      Boolean                     @default(false)
  createdByGrowerId   String?
  createdByGrower     Grower? @relation("ManagedCustomers", fields: [createdByGrowerId], references: [id])
  offPlatformEmail   String?
  conversations      Conversation[]
  favoriteProducts   DispensaryFavoriteProduct[]
  priceAlerts        DispensaryPriceAlert[]
  savedFilters       DispensarySavedFilter[]
  user               User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             Order[]
  acceptedQuotes     AcceptedQuote[]

  @@index([createdByGrowerId])
  @@map("dispensaries")
}

model Strain {
  id          String      @id @default(uuid())
  name        String
  genetics    String?
  growerNotes String?
  growerId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  description String?
  strainType  StrainType?
  batches     Batch[]
  products    Product[]
  grower      Grower      @relation(fields: [growerId], references: [id], onDelete: Cascade)

  @@unique([growerId, name])
  @@map("strains")
}

model Batch {
  id                String    @id @default(uuid())
  batchNumber       String
  lotNumber         String?
  harvestDate       DateTime
  strainId          String
  thc               Decimal?  @db.Decimal(5, 2)
  cbd               Decimal?  @db.Decimal(5, 2)
  totalCannabinoids Decimal?  @db.Decimal(5, 2)
  terpenes          Json?
  coaDocumentUrl    String?
  testResults       Json?
  notes             String?
  growerId          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  grower            Grower    @relation(fields: [growerId], references: [id], onDelete: Cascade)
  strain            Strain    @relation(fields: [strainId], references: [id])
  products          Product[]

  @@unique([growerId, batchNumber])
  @@index([strainId])
  @@map("batches")
}

model ProductTypeConfig {
  id        String   @id @default(uuid())
  type      String
  subTypes  String[]
  growerId  String?
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grower    Grower?  @relation(fields: [growerId], references: [id])

  @@unique([growerId, type])
  @@map("product_type_configs")
}

model Product {
  id                     String                      @id @default(cuid())
  growerId               String
  name                   String
  price                  Decimal                     @db.Decimal(10, 2)
  inventoryQty           Int                         @default(0)
  unit                   String                      @default("gram")
  isAvailable            Boolean                     @default(true)
  description            String?
  images                 String[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  sku                    String?
  brand                  String?
  ingredients            String?
  batchId                String?
  ingredientsDocumentUrl String?
  isFeatured             Boolean                     @default(false)
  status                 ProductStatus               @default(PUBLISHED)
  productType            String?
  strainId               String?
  subType                String?
  deletedAt              DateTime?
  isDeleted              Boolean                     @default(false)
  isPriceVisible         Boolean                     @default(true)
  cbdMax                 Decimal?                    @db.Decimal(5, 2)
  cbdMin                 Decimal?                    @db.Decimal(5, 2)
  harvestDate            DateTime?
  thcMax                 Decimal?                    @db.Decimal(5, 2)
  thcMin                 Decimal?                    @db.Decimal(5, 2)
  favoriteProducts       DispensaryFavoriteProduct[]
  orderItems             OrderItem[]
  priceAlerts            DispensaryPriceAlert[]
  acceptedQuotes         AcceptedQuote[]
  conversationMessages   ConversationMessage[]
  batch                  Batch?                      @relation(fields: [batchId], references: [id])
  grower                 Grower                      @relation(fields: [growerId], references: [id], onDelete: Cascade)
  strain                 Strain?                     @relation(fields: [strainId], references: [id])

  @@index([growerId, isDeleted, isAvailable])
  @@index([isDeleted, isAvailable])
  @@index([strainId])
  @@index([batchId])
  @@map("products")
}

model Order {
  id                  String             @id @default(cuid())
  orderId             String             @unique @default(cuid())
  growerId            String
  dispensaryId        String
  status              OrderStatus        @default(PENDING)
  totalAmount         Decimal            @db.Decimal(10, 2)
  subtotal            Decimal            @db.Decimal(10, 2)
  tax                 Decimal            @default(0) @db.Decimal(10, 2)
  shippingFee         Decimal            @default(0) @db.Decimal(10, 2)
  notes               String?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  createdBy           OrderCreatedBy     @default(DISPENSARY)
  buyerAcknowledgedAt DateTime?
  items               OrderItem[]
  dispensary          Dispensary         @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  grower              Grower             @relation(fields: [growerId], references: [id], onDelete: Cascade)
  acceptedQuotes      AcceptedQuote[]
  statusEvents        OrderStatusEvent[]

  @@index([growerId, status, createdAt])
  @@index([dispensaryId, status, createdAt])
  @@index([growerId, createdAt])
  @@index([dispensaryId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  productId       String
  growerId        String
  quantity        Int            @default(1)
  unitPrice       Decimal        @db.Decimal(10, 2)
  catalogUnitPrice Decimal?       @db.Decimal(10, 2)
  priceOverrideReason String?     @db.VarChar(240)
  totalPrice      Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  acceptedQuoteId String?
  grower          Grower         @relation(fields: [growerId], references: [id])
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])
  acceptedQuote   AcceptedQuote? @relation(fields: [acceptedQuoteId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([growerId])
  @@index([acceptedQuoteId])
  @@map("order_items")
}

model DispensaryFavoriteProduct {
  id           String     @id @default(cuid())
  dispensaryId String
  productId    String
  createdAt    DateTime   @default(now())
  dispensary   Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([dispensaryId, productId])
  @@index([dispensaryId, createdAt])
  @@index([productId])
  @@map("dispensary_favorite_products")
}

model DispensarySavedFilter {
  id           String     @id @default(cuid())
  dispensaryId String
  name         String
  filters      Json
  searchQuery  String     @default("")
  sortBy       String     @default("default")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  dispensary   Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)

  @@index([dispensaryId, createdAt])
  @@map("dispensary_saved_filters")
}

model DispensaryPriceAlert {
  id            String     @id @default(cuid())
  dispensaryId  String
  productId     String
  targetPrice   Decimal    @db.Decimal(10, 2)
  currentPrice  Decimal    @db.Decimal(10, 2)
  originalPrice Decimal?   @db.Decimal(10, 2)
  isTriggered   Boolean    @default(false)
  triggeredAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  dispensary    Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([dispensaryId, productId])
  @@index([dispensaryId, createdAt])
  @@index([productId])
  @@map("dispensary_price_alerts")
}

model Conversation {
  id                   String                @id @default(cuid())
  growerId             String
  dispensaryId         String
  productId            String?
  createdByUserId      String?
  growerLastReadAt     DateTime?
  dispensaryLastReadAt DateTime?
  lastMessageAt        DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  acceptedQuotes       AcceptedQuote[]
  messages             ConversationMessage[]
  dispensary           Dispensary            @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  grower               Grower                @relation(fields: [growerId], references: [id], onDelete: Cascade)
  createdBy            User?                 @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([growerId, dispensaryId])
  @@index([growerId, dispensaryId, productId])
  @@index([growerId, lastMessageAt])
  @@index([dispensaryId, lastMessageAt])
  @@map("conversations")
}

model ConversationMessage {
  id                   String                  @id @default(cuid())
  conversationId       String
  senderUserId         String
  messageType          ConversationMessageType @default(TEXT)
  body                 String
  productId            String?
  offerQuantity        Int?
  offerUnitPrice       Decimal?                @db.Decimal(10, 2)
  offerNote            String?
  offerStatus          OfferStatus?
  respondedToMessageId String?
  createdAt            DateTime                @default(now())
  conversation         Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender               User                    @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  acceptedQuote        AcceptedQuote?
  product              Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  respondedToMessage   ConversationMessage?    @relation("QuoteResponse", fields: [respondedToMessageId], references: [id], onDelete: SetNull)
  responses            ConversationMessage[]   @relation("QuoteResponse")

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([productId])
  @@index([respondedToMessageId])
  @@map("conversation_messages")
}

model AcceptedQuote {
  id                String              @id @default(cuid())
  conversationId    String
  messageId         String              @unique
  growerId          String
  dispensaryId      String
  productId         String
  quantity          Int?
  unitPrice         Decimal             @db.Decimal(10, 2)
  note              String?
  acceptedAt        DateTime            @default(now())
  expiresAt         DateTime
  consumedByOrderId String?
  conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message           ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  grower            Grower              @relation(fields: [growerId], references: [id], onDelete: Cascade)
  dispensary        Dispensary          @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  consumedByOrder   Order?              @relation(fields: [consumedByOrderId], references: [id], onDelete: SetNull)
  orderItems        OrderItem[]

  @@index([dispensaryId, growerId, productId, expiresAt])
  @@index([consumedByOrderId])
  @@map("accepted_quotes")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model OrderStatusEvent {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  actorRole   UserRole
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser   User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorUserId])
  @@map("order_status_events")
}

enum UserRole {
  ADMIN
  GROWER
  DISPENSARY
}

/// Intentionally preserves the legacy lowercase values stored in Postgres.
enum LicenseStatus {
  pending_review
  verified
  expired
  rejected
}

enum ConversationMessageType {
  TEXT
  PRICING_REQUEST
  OFFER
  SYSTEM
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
}

enum StrainType {
  INDICA
  SATIVA
  HYBRID
  SATIVA_DOM_HYBRID
  INDICA_DOM_HYBRID
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderCreatedBy {
  DISPENSARY
  GROWER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}


model AuthRateLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_webhook_events")
}
