generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  role                 UserRole              @default(GROWER)
  growerId             String?
  dispensaryId         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  passwordHash         String?
  conversationMessages ConversationMessage[]
  dispensary           Dispensary?
  grower               Grower?
  sessions             Session[]

  @@map("users")
}

model Grower {
  id                  String              @id @default(cuid())
  userId              String              @unique
  businessName        String
  licenseNumber       String?
  phone               String?
  address             String?
  city                String?
  state               String?             @default("VT")
  zip                 String?
  website             String?
  description         String?
  logo                String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  connectOnboardedAt  DateTime?
  isVerified          Boolean             @default(false)
  stripeAccountId     String?
  stripeAccountStatus String?             @default("pending")
  contactName         String?
  licenseExpiry       DateTime?
  batches             Batch[]
  cartItems           CartItem[]
  conversations       Conversation[]
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrcSyncLogs       MetrcSyncLog[]
  orderItems          OrderItem[]
  orders              Order[]
  productTypeConfigs  ProductTypeConfig[]
  products            Product[]
  strains             Strain[]

  @@map("growers")
}

model Dispensary {
  id                 String         @id @default(cuid())
  userId             String         @unique
  businessName       String
  licenseNumber      String?
  phone              String?
  address            String?
  city               String?
  state              String?        @default("VT")
  zip                String?
  website            String?
  description        String?
  logo               String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  isVerified         Boolean        @default(false)
  contactName        String?
  licenseExpiry      DateTime?
  licenseReviewNotes String?
  licenseState       String?        @default("VT")
  licenseStatus      LicenseStatus  @default(pending_review)
  verifiedAt         DateTime?
  cart               Cart?
  conversations      Conversation[]
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             Order[]

  @@map("dispensaries")
}

model Strain {
  id          String      @id @default(uuid())
  name        String
  genetics    String?
  growerNotes String?
  growerId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  description String?
  strainType  StrainType?
  batches     Batch[]
  products    Product[]
  grower      Grower      @relation(fields: [growerId], references: [id], onDelete: Cascade)

  @@unique([growerId, name])
  @@map("strains")
}

model Batch {
  id                String    @id @default(uuid())
  batchNumber       String
  lotNumber         String?
  harvestDate       DateTime
  strainId          String
  thc               Float?
  cbd               Float?
  totalCannabinoids Float?
  terpenes          Json?
  coaDocumentUrl    String?
  testResults       Json?
  notes             String?
  growerId          String
  createdAt         DateTime  @default(now())
  grower            Grower    @relation(fields: [growerId], references: [id], onDelete: Cascade)
  strain            Strain    @relation(fields: [strainId], references: [id])
  products          Product[]

  @@unique([growerId, batchNumber])
  @@map("batches")
}

model ProductTypeConfig {
  id        String   @id @default(uuid())
  type      String
  subTypes  String[]
  growerId  String?
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  grower    Grower?  @relation(fields: [growerId], references: [id])

  @@unique([growerId, type])
  @@map("product_type_configs")
}

model Product {
  id                     String      @id @default(cuid())
  growerId               String
  name                   String
  price                  Decimal     @db.Decimal(10, 2)
  inventoryQty           Int         @default(0)
  unit                   String      @default("gram")
  isAvailable            Boolean     @default(true)
  description            String?
  images                 String[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  lastSyncedAt           DateTime?
  sku                    String?
  brand                  String?
  ingredients            String?
  batchId                String?
  categoryLegacy         String?
  cbdLegacy              Float?
  ingredientsDocumentUrl String?
  isFeatured             Boolean     @default(false)
  productType            String?
  strainId               String?
  strainLegacy           String?
  subType                String?
  subcategoryLegacy      String?
  thcLegacy              Float?
  deletedAt              DateTime?
  isDeleted              Boolean     @default(false)
  isPriceVisible         Boolean     @default(true)
  cbdMax                 Decimal?    @db.Decimal(5, 2)
  cbdMin                 Decimal?    @db.Decimal(5, 2)
  harvestDate            DateTime?
  thcMax                 Decimal?    @db.Decimal(5, 2)
  thcMin                 Decimal?    @db.Decimal(5, 2)
  cartItems              CartItem[]
  orderItems             OrderItem[]
  batch                  Batch?      @relation(fields: [batchId], references: [id])
  grower                 Grower      @relation(fields: [growerId], references: [id], onDelete: Cascade)
  strain                 Strain?     @relation(fields: [strainId], references: [id])

  @@map("products")
}

model Order {
  id           String      @id @default(cuid())
  orderId      String      @unique @default(cuid())
  growerId     String
  dispensaryId String
  status       OrderStatus @default(PENDING)
  totalAmount  Decimal     @db.Decimal(10, 2)
  subtotal     Decimal     @db.Decimal(10, 2)
  tax          Decimal     @default(0) @db.Decimal(10, 2)
  shippingFee  Decimal     @default(0) @db.Decimal(10, 2)
  notes        String?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  dispensary   Dispensary  @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  grower       Grower      @relation(fields: [growerId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  growerId   String
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  grower     Grower   @relation(fields: [growerId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model MetrcSyncLog {
  id            String   @id @default(cuid())
  growerId      String
  recordsSynced Int      @default(0)
  success       Boolean  @default(true)
  errorMessage  String?
  createdAt     DateTime @default(now())
  grower        Grower   @relation(fields: [growerId], references: [id])

  @@map("metrc_sync_logs")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Cart {
  id           String     @id @default(cuid())
  dispensaryId String     @unique
  subtotal     Decimal    @default(0) @db.Decimal(10, 2)
  tax          Decimal    @default(0) @db.Decimal(10, 2)
  total        Decimal    @default(0) @db.Decimal(10, 2)
  itemCount    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]
  dispensary   Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  growerId   String
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  grower     Grower   @relation(fields: [growerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Conversation {
  id                   String                @id @default(cuid())
  growerId             String
  dispensaryId         String
  productId            String?
  createdByUserId      String
  growerLastReadAt     DateTime?
  dispensaryLastReadAt DateTime?
  lastMessageAt        DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  messages             ConversationMessage[]
  dispensary           Dispensary            @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  grower               Grower                @relation(fields: [growerId], references: [id], onDelete: Cascade)

  @@unique([growerId, dispensaryId])
  @@index([growerId, lastMessageAt])
  @@index([dispensaryId, lastMessageAt])
  @@map("conversations")
}

model ConversationMessage {
  id                   String                  @id @default(cuid())
  conversationId       String
  senderUserId         String
  messageType          ConversationMessageType @default(TEXT)
  body                 String
  productId            String?
  offerQuantity        Int?
  offerUnitPrice       Decimal?                @db.Decimal(10, 2)
  offerNote            String?
  offerStatus          OfferStatus?
  respondedToMessageId String?
  createdAt            DateTime                @default(now())
  conversation         Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender               User                    @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("conversation_messages")
}

enum UserRole {
  ADMIN
  GROWER
  DISPENSARY
}

enum LicenseStatus {
  pending_review
  verified
  expired
  rejected
}

enum ConversationMessageType {
  TEXT
  PRICING_REQUEST
  OFFER
  SYSTEM
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
}

enum StrainType {
  INDICA
  SATIVA
  HYBRID
  SATIVA_DOM_HYBRID
  INDICA_DOM_HYBRID
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  CRYPTO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}
