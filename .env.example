# PhenoFarm environment example
# Copy to .env.local for local development or use these names in Vercel.
# Never commit real secrets.

# Required
DATABASE_URL=
NEXTAUTH_URL=
AUTH_SECRET=
NEXT_PUBLIC_API_URL=

# Optional / provider-specific
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
BLOB_READ_WRITE_TOKEN=

# Account email (required to enable sign-up, verification and password recovery)
AUTH_MAIL_PROVIDER=resend
RESEND_API_KEY=
AUTH_MAIL_FROM=
AUTH_MAIL_REPLY_TO=

# Isolated local auth tests only; rejected in production and with remote databases
AUTH_MAIL_TEST_URL=
AUTH_MAIL_TEST_KEY=
